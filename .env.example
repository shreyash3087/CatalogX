# ==============================================================================
# CatalogX Monorepo Root Environment Configuration
# ==============================================================================

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=catalogx_db

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# LLM Provider Configuration (Azure OpenAI / OpenAI / Gemini)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-nano
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Merchant Node Endpoints (Local or Deployed)
URBANSTRIDE_URL=http://localhost:3001
TECHCART_URL=http://localhost:3002
NEXT_PUBLIC_URBANSTRIDE_URL=http://localhost:3001
NEXT_PUBLIC_TECHCART_URL=http://localhost:3002

# Spend Governor Gating Thresholds (in Paise, ₹1 = 100 Paise)
AUTO_APPROVE_THRESHOLD=150000
NOTIFY_THRESHOLD=300000
CONFIRM_THRESHOLD=500000
MAX_RETRIES=3
